# Modelo de /opt/whatsapp-avilaops-com/.env (modo 600). Sem segredo aqui: a
# chave e gerada no servidor e nunca sai de la.

# Cabecalho `apikey` de toda chamada. A mesma vai na credencial do n8n.
API_KEY=<chave-gerada-no-servidor>

# Destinos permitidos, no formato nome=endereco;nome=endereco. So conversa
# (@s.whatsapp.net) e canal (@newsletter); Status e grupo sao recusados.
# O endereco do canal sai de GET /canal?convite=<codigo do link>, depois de parear.
DESTINOS=eu=5517997811471@s.whatsapp.net

LOG_LEVEL=info
