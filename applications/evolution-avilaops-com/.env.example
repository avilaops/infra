# Modelo de /opt/evolution-avilaops-com/.env (modo 600). Sem segredo aqui: os
# dois valores marcados com <...> sao gerados no servidor e nunca saem de la.
# Nomes de variavel conferidos no .env.example da Evolution API 2.3.7.

SERVER_NAME=evolution
SERVER_TYPE=http
SERVER_PORT=8080
# Endereco pelo qual o n8n alcanca a API (rede edge, sem dominio publico).
SERVER_URL=http://172.31.0.14:8080

TELEMETRY_ENABLED=false
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

LOG_LEVEL=ERROR,WARN,INFO,LOG
LOG_COLOR=false
LOG_BAILEYS=error

# false = a instancia nao e apagada da memoria quando fica sem conexao.
DEL_INSTANCE=false

# PostgreSQL do host. Senha gerada no servidor, so com [A-Za-z0-9] para nao
# precisar de escape na URI.
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://evolution_avilaops_com:<senha-gerada-no-servidor>@host.docker.internal:5432/evolution_avilaops_com?schema=evolution_api
DATABASE_CONNECTION_CLIENT_NAME=evolution_avilaops_com

# So o necessario para publicar Status: a instancia e os contatos (o
# `allContacts` do sendStatus le os contatos salvos aqui). O resto fica fora
# para o banco nao inchar com historico de conversa.
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_IS_ON_WHATSAPP=false
DATABASE_DELETE_MESSAGE=false

# O Redis do host so escuta em 127.0.0.1; a Evolution usa cache em memoria.
CACHE_REDIS_ENABLED=false
CACHE_LOCAL_ENABLED=true

# Integracoes que nao sao usadas.
RABBITMQ_ENABLED=false
SQS_ENABLED=false
WEBSOCKET_ENABLED=false
PUSHER_ENABLED=false
WEBHOOK_GLOBAL_ENABLED=false
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
S3_ENABLED=false

CONFIG_SESSION_PHONE_CLIENT=AvilaOps
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30

# Chave global da API (header `apikey`). Gerada no servidor; a mesma vai na
# credencial httpHeaderAuth do n8n.
AUTHENTICATION_API_KEY=<chave-gerada-no-servidor>
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
LANGUAGE=pt-BR
