{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "gauge", "name": "Gauge", "version": "" }
  ],
  "annotations": { "list": [] },
  "description": "Saúde de SEO e auditoria técnica do portfólio Ávila Ops",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "📊 Visão Geral do Portfólio",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true, "inspect": false },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 80 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Score SEO" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 } ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "PageSpeed" },
            "properties": [
              { "id": "unit", "value": "none" },
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 90 } ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Links Quebrados" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 } ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Expira (dias)" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
              { "id": "thresholds", "value": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 14 }, { "color": "yellow", "value": 30 }, { "color": "green", "value": 60 } ] } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Online" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "1": { "text": "✅ OK", "color": "green" }, "0": { "text": "❌ Fora", "color": "red" } } } ] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "cellHeight": "sm",
        "footer": { "countRows": false, "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true,
        "sortBy": [{ "displayName": "Score SEO", "desc": false }]
      },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_seo_audit_score",
          "legendFormat": "{{fqdn}}",
          "instant": true,
          "refId": "SEO"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_pagespeed_performance_score",
          "legendFormat": "{{fqdn}}",
          "instant": true,
          "refId": "PS"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_broken_links_count",
          "legendFormat": "{{fqdn}}",
          "instant": true,
          "refId": "LINKS"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_domain_expiry_days_remaining",
          "legendFormat": "{{fqdn}}",
          "instant": true,
          "refId": "EXPIRY"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "probe_success{group=\"portfolio\"}",
          "legendFormat": "{{instance}}",
          "instant": true,
          "refId": "PROBE"
        }
      ],
      "title": "Portfólio — Saúde Completa",
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "fqdn" } },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #SEO": "Score SEO",
              "Value #PS": "PageSpeed",
              "Value #LINKS": "Links Quebrados",
              "Value #EXPIRY": "Expira (dias)",
              "Value #PROBE": "Online",
              "fqdn": "Domínio"
            }
          }
        }
      ],
      "type": "table"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 } ] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 15 },
      "id": 10,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "text": {}, "textMode": "auto" },
      "title": "Domínios Online",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(probe_success{group=\"portfolio\"} == 1)",
          "instant": true,
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 15 },
      "id": 11,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "text": {}, "textMode": "auto" },
      "title": "Domínios Fora do Ar",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(probe_success{group=\"portfolio\"} == 0)",
          "instant": true,
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 } ] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 15 },
      "id": 12,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "text": {}, "textMode": "auto" },
      "title": "SSL Expirando < 14 dias",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count((probe_ssl_earliest_cert_expiry - time()) / 86400 < 14)",
          "instant": true,
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 3 } ] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 15 },
      "id": 13,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "text": {}, "textMode": "auto" },
      "title": "Domínios Expirando < 30 dias",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "count(avilaops_domain_expiry_days_remaining < 30)",
          "instant": true,
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 80 } ] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 15 },
      "id": 14,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false }, "text": {}, "textMode": "auto" },
      "title": "Score SEO Médio",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(avilaops_seo_audit_score)",
          "instant": true,
          "refId": "A"
        }
      ],
      "type": "stat"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 90 } ] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 15 },
      "id": 15,
      "options": { "colorMode": "background", "graphMode": "none", "justifyMode": "center", "orientation": "auto", "reduceOptions": { "calcs": ["mean"], "fields": "", "values": false }, "text": {}, "textMode": "auto" },
      "title": "PageSpeed Médio",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avg(avilaops_pagespeed_performance_score)",
          "instant": true,
          "refId": "A"
        }
      ],
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 101,
      "title": "⚡ Core Web Vitals — $fqdn",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 2.5 }, { "color": "red", "value": 4 } ] }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 20 },
      "id": 20,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_pagespeed_lcp_seconds{fqdn=~\"$fqdn\"}",
          "legendFormat": "{{fqdn}}",
          "refId": "A"
        }
      ],
      "title": "LCP — Largest Contentful Paint",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.1 }, { "color": "red", "value": 0.25 } ] }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 20 },
      "id": 21,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_pagespeed_cls{fqdn=~\"$fqdn\"}",
          "legendFormat": "{{fqdn}}",
          "refId": "A"
        }
      ],
      "title": "CLS — Cumulative Layout Shift",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 0.2 }, { "color": "red", "value": 0.5 } ] }
        }
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 20 },
      "id": 22,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_pagespeed_inp_seconds{fqdn=~\"$fqdn\"}",
          "legendFormat": "{{fqdn}}",
          "refId": "A"
        }
      ],
      "title": "INP — Interaction to Next Paint",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "none",
          "min": 0,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "yellow", "value": 50 }, { "color": "green", "value": 90 } ] }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
      "id": 23,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_pagespeed_performance_score{fqdn=~\"$fqdn\"}",
          "legendFormat": "{{fqdn}} — Performance",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_pagespeed_seo_score{fqdn=~\"$fqdn\"}",
          "legendFormat": "{{fqdn}} — SEO PSI",
          "refId": "B"
        }
      ],
      "title": "Score Performance + SEO (PageSpeed Insights)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 10 },
          "unit": "none",
          "min": 0,
          "max": 100
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
      "id": 24,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_seo_audit_score{fqdn=~\"$fqdn\"}",
          "legendFormat": "{{fqdn}}",
          "refId": "A"
        }
      ],
      "title": "Score SEO Técnico (Auditoria interna) ao longo do tempo",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "id": 102,
      "title": "🔍 Auditoria Técnica — Status por domínio",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "auto" }, "filterable": true },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "green", "value": 1 } ] }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Auditoria SEO" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "1": { "text": "✅ OK" }, "0": { "text": "❌ Falhou" } } } ] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "PageSpeed" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "1": { "text": "✅ OK" }, "0": { "text": "❌ Falhou" } } } ] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "IndexNow" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "1": { "text": "✅ OK" }, "0": { "text": "❌ Falhou" } } } ] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Bing" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "1": { "text": "✅ OK" }, "0": { "text": "❌ Falhou" } } } ] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Search Console" },
            "properties": [
              { "id": "mappings", "value": [ { "type": "value", "options": { "1": { "text": "✅ Conectado" }, "0": { "text": "⚠️ Não conectado" } } } ] },
              { "id": "custom.cellOptions", "value": { "type": "color-background" } }
            ]
          }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 37 },
      "id": 30,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true },
      "pluginVersion": "10.4.0",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_seo_audit_last_run_success",
          "legendFormat": "{{fqdn}}",
          "instant": true,
          "refId": "SEO_OK"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_pagespeed_last_run_success",
          "legendFormat": "{{fqdn}}",
          "instant": true,
          "refId": "PS_OK"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_indexnow_submit_last_run_success",
          "legendFormat": "{{fqdn}}",
          "instant": true,
          "refId": "INOW"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_bing_submit_last_run_success",
          "legendFormat": "{{fqdn}}",
          "instant": true,
          "refId": "BING"
        },
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_search_console_connected",
          "legendFormat": "{{fqdn}}",
          "instant": true,
          "refId": "GSC"
        }
      ],
      "title": "Status das Integrações por Domínio",
      "transformations": [
        { "id": "labelsToFields", "options": { "valueLabel": "fqdn" } },
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "Value #SEO_OK": "Auditoria SEO",
              "Value #PS_OK": "PageSpeed",
              "Value #INOW": "IndexNow",
              "Value #BING": "Bing",
              "Value #GSC": "Search Console",
              "fqdn": "Domínio"
            }
          }
        }
      ],
      "type": "table"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "id": 103,
      "title": "🚨 Domínios em Risco",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": { "align": "auto", "cellOptions": { "type": "color-background" }, "filterable": false },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 14 }, { "color": "yellow", "value": 30 } ] },
          "unit": "none"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 50 },
      "id": 40,
      "options": { "cellHeight": "sm", "footer": { "show": false }, "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "${datasource}" },
          "expr": "avilaops_domain_expiry_days_remaining < 30",
          "legendFormat": "{{fqdn}}",
          "instant": true,
          "refId": "A"
        }
      ],
