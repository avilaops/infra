global:
  smtp_smarthost: '${SMTP_HOST}:${SMTP_PORT}'
  smtp_from: '${ALERT_EMAIL_FROM}'
  smtp_auth_username: '${SMTP_USER}'
  smtp_auth_password: '${SMTP_PASSWORD}'
  smtp_require_tls: true

route:
  receiver: 'email'
  group_by: ['alertname', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  routes:
    - receiver: 'email'
      continue: true
      matchers:
        - alertname=~".+"
    - receiver: 'todoist'
      continue: true
      matchers:
        - alertname=~".+"

receivers:
  - name: 'email'
    email_configs:
      - to: '${ALERT_EMAIL_TO}'
        send_resolved: true

  - name: 'todoist'
    webhook_configs:
      - url: 'https://n8n.avilaops.com/webhook/avila-alertmanager'
        send_resolved: true
        http_config:
          authorization:
            credentials: '${ALERTMANAGER_WEBHOOK_TOKEN}'
