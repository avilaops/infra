[Unit]
Description=Renovar credenciais temporárias do acervo fiscal R2
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 /usr/local/lib/avilaops/fiscal-r2/rotacionar.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/lojas/r2-secrets
ReadOnlyPaths=/root/.config/rclone/rclone.conf
