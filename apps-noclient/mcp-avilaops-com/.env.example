# mcp.avilaops.com. Copie para /opt/mcp-avilaops-com/.env (modo 600) e preencha.

# Endereco publico, sem barra no fim. E o emissor (issuer) dos tokens.
URL_PUBLICA=https://mcp.avilaops.com

# Login: cliente OIDC `mcp` cadastrado no auth.avilaops.com, com retorno em
# https://mcp.avilaops.com/oauth/retorno. Quem pode entrar e decidido la
# (aplicacao `mcp` no painel).
AUTH_ISSUER=https://auth.avilaops.com
AUTH_CLIENT_ID=mcp
AUTH_CLIENT_SECRET=

# O MCP da empresa (workflow "MCP - Avila Ops" no n8n) e o token que ele pede.
UPSTREAM_URL=https://n8n.avilaops.com/mcp/avilaops
UPSTREAM_TOKEN=

# Tokens de servico (para maquinas, sem login): lista de SHA-256 em hexadecimal,
# separados por virgula. Gerar o hash: printf %s "$TOKEN" | sha256sum
SERVICO_SHA256=
