# Copie para .env e preencha. NUNCA commitar o .env real.

OBS_DOMAIN=obs.avilaops.com

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Basic Auth extra do Caddy na frente do Grafana (camada dupla).
# Gerar hash com: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'sua-senha'
CADDY_BASICAUTH_USER=admin
CADDY_BASICAUTH_HASH=

# SMTP para o Alertmanager (ex.: Resend, ou outro SMTP existente)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
